  {"cat":"Docker","name":"创建rabbitmq容器","cmd":"docker run \\\r\n -e RABBITMQ_DEFAULT_USER=itcast \\\r\n -e RABBITMQ_DEFAULT_PASS=123321 \\\r\n --name rabbitmq \\\r\n --hostname mq1 \\\r\n -p 15672:15672 \\\r\n -p 5672:5672 \\\r\n -d \\\r\n rabbitmq:3-management","desc":"创建rabbitmq容器多行","sample":""},
