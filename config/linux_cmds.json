  {"cat":"Docker","name":"创建mysql容器","cmd":"docker run -d \\\r\n  --name mysql5725 \\\r\n  --restart=always \\\r\n  -p 3307:3306 \\\r\n  -e MYSQL_ROOT_PASSWORD='123456' \\\r\n  -v /shuangyulin/mysql57/data:/var/lib/mysql \\\r\n  -v /shuangyulin/mysql57/logs:/var/log/mysql \\\r\n  -v /shuangyulin/mysql57/conf:/etc/mysql/conf.d:ro \\\r\n  mysql:5.7.25","desc":"","sample":""},
  {"cat":"Docker","name":"docker配置mysql编码utf8","cmd":"mkdir -p /shuangyulin/mysql57/conf && printf '[client]\\ndefault-character-set=utf8mb4\\n\\n[mysql]\\ndefault-character-set=utf8mb4\\n\\n[mysqld]\\ncharacter-set-server=utf8mb4\\ncollation-server=utf8mb4_unicode_ci\\n' > /shuangyulin/mysql57/conf/my.cnf","desc":"","sample":""},
  {"cat":"Docker","name":"创建redis容器","cmd":"docker run -d \\\r\n  --name redis725 \\\r\n  --restart=always \\\r\n  -p 6379:6379 \\\r\n  -v /shuangyulin/redis/conf:/usr/local/etc/redis:ro \\\r\n  -v /shuangyulin/redis/data:/data \\\r\n  redis:7.2.5 \\\r\n  redis-server /usr/local/etc/redis/redis.conf","desc":"","sample":""},
  {"cat":"Docker","name":"写入redis配置文件","cmd":"mkdir -p /shuangyulin/redis/conf && curl -fL --connect-timeout 15 https://raw.githubusercontent.com/redis/redis/7.2.5/redis.conf -o /shuangyulin/redis/conf/redis.conf && sed -i 's/^bind 127\\.0\\.0\\.1 -::1$/# bind 127.0.0.1 -::1/;s/^protected-mode yes$/protected-mode no/' /shuangyulin/redis/conf/redis.conf","desc":"bind 注释掉\n\n\t\n\n不再只监听本机回环地址\n\nprotected-mode no\n\n\t\n\n关闭保护模式，方便实验环境连接\n\ndaemonize no\n\n\t\n\n在容器前台运行，符合 Docker 运行方式\n\ndir ./\n\n\t\n\n数据目录由启动命令和挂载路径配合使用\n\nappendonly no\n\n\t\n\n默认不启用 AOF，可后续学习时再开启\n\nsave 3600 1 等\n\n\t\n\n保留官方默认 RDB 快照规则\n\nrequirepass\n\n\t\n\n默认不设置密码，需要时可以自行配置","sample":""},
  {"cat":"Docker","name":"创建网络","cmd":"docker network create es-net","desc":"docker创建网络","sample":""},
  {"cat":"Docker","name":"创建elasticsearch容器","cmd":"docker run -d \\\r\n --name es \\\r\n -e \"ES_JAVA_OPTS=-Xms512m -Xmx512m\" \\\r\n -e \"discovery.type=single-node\" \\\r\n -v es-data:/usr/share/elasticsearch/data \\\r\n -v es-plugins:/usr/share/elasticsearch/plugins \\\r\n --privileged \\\r\n --network es-net \\\r\n -p 9200:9200 \\\r\n -p 9300:9300 \\\r\n elasticsearch:7.12.1","desc":"docker创建elasticsearch容器","sample":""},
  {"cat":"Docker","name":"复制宿主机文件到容器","cmd":"docker cp 宿主机路径 容器名称:容器内路径","desc":"也可以路径互换复制容器文件到宿主机","sample":"docker cp /root/test.txt ubuntu-test:/tmp/test.txt"},
