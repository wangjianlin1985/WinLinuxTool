  {"cat":"Docker","name":"Docker配置非安全私有仓库","cmd":"python -c \"import json; p='/etc/docker/daemon.json'; d=json.load(open(p)) if __import__('os').path.exists(p) else {}; a=d.setdefault('insecure-registries',[]); a.append('192.168.79.129:5000') if '192.168.79.129:5000' not in a else None; open(p,'w').write(json.dumps(d,indent=2)+'\\n')\"","desc":"","sample":""},
